# Development template. Production compose forces NODE_ENV=production and requires real HTTPS origins/provider credentials.
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
TZ=Asia/Tashkent
APP_PUBLIC_URL=http://localhost:3000
MINI_APP_URL=http://localhost:5173
# Only set ADMIN_APP_URL when it is a distinct application.
ADMIN_APP_URL=
# Extra trusted origins only; Mini App/admin origins are derived automatically.
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_CIDRS=
# Use a hop count only on managed platforms whose documented edge proxy is
# the sole network path to the process (for example, Render).
TRUST_PROXY_HOPS=0
REQUEST_BODY_LIMIT_BYTES=65536

# In production compose use @postgres:5432 and redis://redis:6379.
# The local PostgreSQL initializer derives credentials from this single URL.
DATABASE_URL=postgresql://zastore:replace_with_random_base64url_password@localhost:5432/zastore_shop?schema=public
REDIS_URL=redis://localhost:6379

# Generate each independently: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=zastore-shop
JWT_AUDIENCE=zastore-mini-app

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
SUPER_ADMIN_TELEGRAM_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_SHORT_NAME=shop
TELEGRAM_MINI_APP_USE_MAIN=false

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PRODUCT_FOLDER=/products
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_IMAGE_WIDTH=6000
MEDIA_MAX_IMAGE_HEIGHT=6000
MEDIA_MAX_VIDEO_BYTES=157286400
MEDIA_MAX_VIDEO_DURATION_SECONDS=60
ORDER_EXPIRATION_INTERVAL_MS=30000
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=8
