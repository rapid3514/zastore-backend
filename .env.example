NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
TZ=Asia/Tashkent

POSTGRES_USER=zastore
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_DB=zastore_shop
POSTGRES_PORT=5432
DATABASE_URL=postgresql://zastore:replace_with_a_strong_local_password@localhost:5432/zastore_shop?schema=public
DATABASE_URL_DOCKER=postgresql://zastore:replace_with_a_strong_local_password@postgres:5432/zastore_shop?schema=public
REDIS_URL=redis://localhost:6379
REDIS_URL_DOCKER=redis://redis:6379

JWT_ACCESS_SECRET=replace_with_a_48_byte_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_48_byte_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300
SUPER_ADMIN_TELEGRAM_ID=

BACKEND_PUBLIC_URL=https://your-backend.trycloudflare.com
MINI_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
