generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  GUEST
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum ProductAvailabilityStatus {
  IN_STOCK
  ARRIVING_IN_14_DAYS
  OUT_OF_STOCK
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  telegramId      BigInt           @unique
  firstName       String
  lastName        String?
  username        String?
  phone           String?          @unique
  phoneVerifiedAt DateTime?
  avatarUrl       String?
  role            UserRole         @default(GUEST)
  isBlocked       Boolean          @default(false)
  lastSeenAt      DateTime?
  refreshSessions RefreshSession[] @relation("UserRefreshSessions")
  orders          Order[]          @relation("UserOrders")
  auditLogs       AuditLog[]       @relation("UserAuditLogs")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([role, lastSeenAt])
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String
  description              String?
  price                    Decimal                   @db.Decimal(10, 2)
  cargoPrice               Decimal?                  @db.Decimal(10, 2)
  imageUrl                 String?
  imageFileId              String?
  categoryId               String                    @db.Uuid
  category                 Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  availabilityStatus       ProductAvailabilityStatus @default(IN_STOCK)
  version                  Int                       @default(0)
  telegramChannelMessageId Int?
  telegramButtonMessageId  Int?
  telegramPublishedAt      DateTime?
  telegramSyncedAt         DateTime?
  telegramSyncStatus       TelegramProductSyncStatus @default(PENDING)
  orderItems               OrderItem[]               @relation("ProductOrderItems")
  media                    ProductMedia[]
  telegramMessages         ProductTelegramMessage[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([categoryId])
  @@index([createdAt])
  @@index([availabilityStatus])
  @@index([imageFileId])
  @@index([telegramSyncStatus])
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

// Tracks provider-side media lifecycle independently from Product rows.  A file
// marked DELETE_PENDING can never be attached by the application, preventing a
// concurrent cleanup from deleting an asset a product is about to reference.
enum MediaAssetStatus {
  ACTIVE
  DELETE_PENDING
  DELETED
}

model MediaAsset {
  fileId               String           @id
  status               MediaAssetStatus @default(ACTIVE)
  deleteRequestedAt    DateTime?
  deleteLeaseExpiresAt DateTime?
  deletedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([status, deleteRequestedAt])
}

model ProductMedia {
  id        String           @id @default(uuid()) @db.Uuid
  productId String           @db.Uuid
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      ProductMediaType
  fileId    String
  url       String
  position  Int
  mimeType  String?
  width     Int?
  height    Int?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([productId, fileId])
  @@unique([productId, type, position])
  @@index([productId, type, position])
  @@index([fileId])
}

model ProductTelegramMessage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  messageId Int
  position  Int
  createdAt DateTime @default(now())

  @@unique([productId, messageId])
  @@unique([productId, position])
  @@index([productId, position])
}

enum TelegramProductSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum AuditAction {
  CATEGORY_CREATE
  CATEGORY_UPDATE
  CATEGORY_STATUS_CHANGE
  CATEGORY_DELETE
  PRODUCT_CREATE
  PRODUCT_UPDATE
  PRODUCT_STATUS_CHANGE
  PRODUCT_DELETE
  ORDER_CONFIRM
  ORDER_REJECT
  ORDER_STATUS_CHANGE
  WORK_HOURS_UPDATE
  ADMIN_UPDATE
  ADMIN_PROMOTE
  ADMIN_DEMOTE
  ADMIN_BLOCK
  ADMIN_UNBLOCK
}

enum AuditEntityType {
  CATEGORY
  PRODUCT
  ORDER
  WORK_HOURS
  USER
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Order {
  id                   String      @id @default(uuid()) @db.Uuid
  userId               String      @db.Uuid
  idempotencyKey       String?     @db.Uuid
  requestHash          String?     @db.Char(64)
  user                 User        @relation("UserOrders", fields: [userId], references: [id], onDelete: Restrict)
  status               OrderStatus @default(PENDING_CONFIRMATION)
  phone                String?
  deliveryAddress      String?
  btcPostBranchNumber  String?
  latitude             Decimal?    @db.Decimal(9, 6)
  longitude            Decimal?    @db.Decimal(9, 6)
  note                 String?
  subtotal             Decimal     @db.Decimal(10, 2)
  total                Decimal     @db.Decimal(10, 2)
  confirmationDeadline DateTime
  confirmedAt          DateTime?
  cancelledAt          DateTime?
  completedAt          DateTime?
  expiredAt            DateTime?
  cancelReason         String?
  items                OrderItem[]
  payment              Payment?
  notifications        NotificationOutbox[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([confirmationDeadline])
  @@unique([userId, idempotencyKey])
  @@index([status, confirmationDeadline])
}

enum NotificationKind {
  NEW_ORDER
  ORDER_STATUS
  ORDER_REJECTED
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  UNCERTAIN
}

model NotificationOutbox {
  id            String                     @id @default(uuid()) @db.Uuid
  sequence      BigInt                     @unique @default(autoincrement())
  eventKey      String                     @unique
  orderId       String                     @db.Uuid
  order         Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recipient     BigInt
  kind          NotificationKind
  orderStatus   OrderStatus
  status        NotificationDeliveryStatus @default(PENDING)
  attempts      Int                        @default(0)
  availableAt   DateTime                   @default(now())
  claimedAt     DateTime?
  claimToken    String?                    @db.Uuid
  deliveredAt   DateTime?
  lastErrorCode String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([status, availableAt])
  @@index([status, claimedAt])
  @@index([orderId])
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  orderId    String        @unique @db.Uuid
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amount     Decimal       @db.Decimal(10, 2)
  status     PaymentStatus @default(PENDING)
  provider   String?
  externalId String?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([provider])
}

model AuditLog {
  id          String          @id @default(uuid()) @db.Uuid
  actorUserId String          @db.Uuid
  actor       User            @relation("UserAuditLogs", fields: [actorUserId], references: [id], onDelete: Restrict)
  action      AuditAction
  entityType  AuditEntityType
  entityId    String
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?  @db.Uuid
  product     Product? @relation("ProductOrderItems", fields: [productId], references: [id], onDelete: SetNull)
  productName String
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model WorkHour {
  id        String   @id @default(uuid()) @db.Uuid
  dayOfWeek WeekDay  @unique
  isOpen    Boolean  @default(true)
  openTime  String?
  closeTime String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dayOfWeek])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  familyId  String    @default(uuid()) @db.Uuid
  parentId  String?   @unique @db.Uuid
  parent    RefreshSession? @relation("RefreshRotation", fields: [parentId], references: [id], onDelete: SetNull)
  replacement RefreshSession? @relation("RefreshRotation")
  tokenHash String
  userId    String    @db.Uuid
  user      User      @relation("UserRefreshSessions", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}
